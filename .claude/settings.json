{
    "permissions": {
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.local)",
            "Read(**/.env.production)",
            "Read(**/.dev.vars)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Bash(cat .env*)",
            "Bash(git reset --hard *)",
            "Bash(git clean -f*)",
            "Bash(git push --force *)",
            "Bash(git push -f *)",
            "Bash(rm -rf *)",
            "Bash(supabase db reset*)"
        ],
        "ask": [
            "Bash(git push *)",
            "Bash(curl *)",
            "Bash(wget *)",
            "WebFetch",
            "Bash(npm publish *)",
            "Bash(wrangler deploy*)",
            "Bash(gh pr create *)"
        ]
    }
}
