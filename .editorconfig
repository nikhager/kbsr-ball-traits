# https://editorconfig.org — keeps formatting consistent across editors
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python follows the Google Python Style Guide: 4 spaces
[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
